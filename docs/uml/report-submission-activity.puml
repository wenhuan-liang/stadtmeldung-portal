@startuml
start
:Nutzer oeffnet "Neue Meldung";
:Standort auf Karte waehlen\noder GPS verwenden;
:Titel, Kategorie und Beschreibung eingeben;

if (Kategorie ist Defekt?) then (ja)
  :Konkrete Defektart auswaehlen;
else (nein)
endif

:Optional ein Foto auswaehlen;
:Formular absenden;

if (Eingaben gueltig?) then (ja)
